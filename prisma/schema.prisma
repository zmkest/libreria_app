generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ USUARIOS ============

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

// ============ CLIENTES ============

model Customer {
  id        String   @id @default(cuid())
  idNumber  String?
  firstName String
  lastName  String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([idNumber])
  @@index([lastName, firstName])
}

// ============ PRODUCTOS ============

model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  purchasePrice Decimal  @db.Decimal(10, 2)
  salePrice     Decimal  @db.Decimal(10, 2)
  // Campo dormido: no mostrar en UI, no modificar al vender
  stock         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sales         Sale[]

  @@index([code])
  @@index([name])
}

// ============ VENTAS ============

enum SaleStatus {
  COMPLETADA
  CANCELADA
}

model Sale {
  id           String     @id @default(cuid())
  saleNumber   Int        @unique @default(autoincrement())

  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])

  userId       String
  user         User       @relation(fields: [userId], references: [id])

  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  productName  String
  unitPrice    Decimal    @db.Decimal(10, 2)
  quantity     Int
  total        Decimal    @db.Decimal(10, 2)

  status       SaleStatus @default(COMPLETADA)
  cancelReason String?
  cancelledAt  DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([createdAt])
  @@index([customerId])
  @@index([userId])
  @@index([productId])
  @@index([status])
}
